<?xml version="1.0"?>
<!--
  Secret-bearing config.xml elements, laid out at their real OPNsense paths
  (opnsense/core and opnsense/plugins models and legacy PHP, checked 2026-11).
  Every secret value starts with CANARY-, every value that must survive
  redaction starts with VISIBLE-.
-->
<opnsense>
  <system>
    <hostname>VISIBLE-hostname</hostname>
    <user>
      <name>VISIBLE-root</name>
      <password>CANARY-user-password</password>
      <otp_seed>CANARY-user-otp-seed</otp_seed>
      <authorizedkeys>CANARY-user-authorizedkeys</authorizedkeys>
      <apikeys>
        <item>
          <key>CANARY-user-apikey-key</key>
          <secret>CANARY-user-apikey-secret</secret>
        </item>
      </apikeys>
    </user>
    <authserver>
      <name>VISIBLE-ldap</name>
      <ldap_binddn>VISIBLE-binddn</ldap_binddn>
      <ldap_bindpw>CANARY-ldap-bindpw</ldap_bindpw>
    </authserver>
    <authserver>
      <name>VISIBLE-radius</name>
      <radius_secret>CANARY-radius-secret</radius_secret>
    </authserver>
    <ssh>
      <passwordauth>VISIBLE-passwordauth</passwordauth>
    </ssh>
  </system>
  <cert>
    <descr>VISIBLE-cert-descr</descr>
    <crt>VISIBLE-cert-crt</crt>
    <prv>CANARY-cert-prv</prv>
  </cert>
  <ca>
    <descr>VISIBLE-ca-descr</descr>
    <crt>VISIBLE-ca-crt</crt>
    <prv>CANARY-ca-prv</prv>
  </ca>
  <interfaces>
    <opt1>
      <descr>VISIBLE-wifi-descr</descr>
      <wireless>
        <wpa>
          <passphrase>CANARY-wpa-passphrase</passphrase>
        </wpa>
        <wep>
          <keys>CANARY-wep-keys</keys>
        </wep>
      </wireless>
    </opt1>
  </interfaces>
  <openvpn>
    <openvpn-server>
      <description>VISIBLE-openvpn-server</description>
      <shared_key>CANARY-openvpn-shared-key</shared_key>
      <tls>CANARY-openvpn-tls</tls>
    </openvpn-server>
    <openvpn-client>
      <auth_user>VISIBLE-openvpn-auth-user</auth_user>
      <auth_pass>CANARY-openvpn-auth-pass</auth_pass>
    </openvpn-client>
  </openvpn>
  <ipsec>
    <phase1>
      <pre-shared-key>CANARY-ipsec-pre-shared-key</pre-shared-key>
    </phase1>
  </ipsec>
  <dnsupdates>
    <dnsupdate>
      <keyname>VISIBLE-rfc2136-keyname</keyname>
      <keydata>CANARY-rfc2136-keydata</keydata>
    </dnsupdate>
  </dnsupdates>
  <OPNsense>
    <wireguard>
      <server>
        <servers>
          <server>
            <pubkey>VISIBLE-wg-server-pubkey</pubkey>
            <privkey>CANARY-wg-server-privkey</privkey>
          </server>
        </servers>
      </server>
      <client>
        <clients>
          <client>
            <pubkey>VISIBLE-wg-peer-pubkey</pubkey>
            <psk>CANARY-wg-peer-psk</psk>
          </client>
        </clients>
      </client>
    </wireguard>
    <netsnmp>
      <general>
        <syslocation>VISIBLE-snmp-syslocation</syslocation>
        <community>CANARY-snmp-community</community>
      </general>
    </netsnmp>
    <ZabbixAgent>
      <settings>
        <features>
          <encryptionidentity>VISIBLE-zabbix-identity</encryptionidentity>
          <encryptionpsk>CANARY-zabbix-encryptionpsk</encryptionpsk>
        </features>
      </settings>
    </ZabbixAgent>
    <AcmeClient>
      <accounts>
        <account>
          <name>VISIBLE-acme-account</name>
          <eab_hmac>CANARY-acme-eab-hmac</eab_hmac>
        </account>
      </accounts>
      <validations>
        <validation>
          <dns_netcup_pw>CANARY-acme-netcup-pw</dns_netcup_pw>
          <dns_pleskxml_pass>CANARY-acme-pleskxml-pass</dns_pleskxml_pass>
          <dns_kas_authdata>CANARY-acme-kas-authdata</dns_kas_authdata>
        </validation>
      </validations>
    </AcmeClient>
    <caddy>
      <reverseproxy>
        <basicauth>
          <basicauthuser>VISIBLE-caddy-user</basicauthuser>
          <basicauthpass>CANARY-caddy-basicauthpass</basicauthpass>
        </basicauth>
      </reverseproxy>
    </caddy>
  </OPNsense>
</opnsense>
